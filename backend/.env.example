# ========================================
# BACKEND ENVIRONMENT VARIABLES
# ========================================

# Server Configuration
PORT=5009
NODE_ENV=development

# Firebase Admin SDK Configuration
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id

# MongoDB Atlas Configuration
# Get this from MongoDB Atlas > Connect > Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Spotify API Configuration (Optional - for playlist import)
# Get these from https://developer.spotify.com/dashboard/applications
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/callback

# JWT Secret (for additional security)
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-characters-long

# Frontend URL (for CORS - set to your deployed frontend URL in production)
FRONTEND_URL=http://localhost:5173

# Demo Mode (set to true for development without real Firebase)
ADMIN_TEST_MODE=false

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379

# ────────────────────────────────────────────────────────────────────────────
# YouTube Discovery Enhancement (Home page background discovery)
# ────────────────────────────────────────────────────────────────────────────

# Server-side YouTube Data API v3 key (NOT OAuth — a simple API key)
# Get from: https://console.cloud.google.com > APIs & Services > Credentials > Create API Key
# Enable: YouTube Data API v3
# NEVER expose this to the frontend.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Master on/off switch (default: false — discovery is disabled until API key is set)
YOUTUBE_DISCOVERY_ENABLED=false

# Discovery cache TTL in hours (default: 6 = refresh 4 times per day)
DISCOVERY_REFRESH_INTERVAL_HOURS=6

# Minimum JioSaavn match confidence [0.0–1.0] — lower = more results, more errors
DISCOVERY_MIN_CONFIDENCE=0.65

# Diversity rules
DISCOVERY_MAX_PER_ALBUM=2
DISCOVERY_MAX_PER_ARTIST=3

# Admin secret for POST /api/home/refresh manual trigger
ADMIN_SECRET=your_strong_random_admin_secret_here